<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form Ceklis Daily Worker - Digimap</title>
    <!-- Tailwind CSS untuk styling modern -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen py-10 px-4 sm:px-6 lg:px-8">

    <div class="max-w-4xl mx-auto bg-slate-900/80 backdrop-blur-xl border border-slate-800 rounded-2xl shadow-2xl overflow-hidden p-6 sm:p-10">
        
        <!-- Header -->
        <div class="text-center border-b border-slate-800 pb-6 mb-8">
            <span class="text-xs font-semibold uppercase tracking-widest text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">Digimap Retail Training</span>
            <h1 class="text-2xl sm:text-3xl font-bold mt-3 text-white tracking-tight">FORM CEKLIS DAILY WORKER</h1>
        </div>

        <form id="dwForm" class="space-y-8">
            
            <!-- A. DATA STAFF -->
            <div class="bg-slate-800/40 border border-slate-800 rounded-xl p-5 sm:p-6 space-y-4">
                <h2 class="text-lg font-semibold text-indigo-400 border-b border-slate-800 pb-2">A. DATA STAFF</h2>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1">Nama Staff</label>
                        <input type="text" id="nama" required class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1">Tanggal Pelatihan</label>
                        <input type="date" id="tanggal" required class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1">Store / Lokasi</label>
                        <input type="text" id="store" placeholder="Contoh: Digimap Grand Indonesia" required class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </div>
                </div>
            </div>

            <!-- B. PETUNJUK & PANDUAN PENILAIAN -->
            <div class="bg-indigo-950/20 border border-indigo-500/20 rounded-xl p-4 sm:p-5 text-sm text-indigo-200 space-y-1">
                <p class="font-semibold text-indigo-300">B. PETUNJUK & PANDUAN PENILAIAN</p>
                <p>1. Pastikan semua Staff Daily Worker sudah mendapatkan Training DigiX/Activation Device/Roleplay oleh ST/SPV.</p>
                <p>2. Berikan Komentar/Catatan untuk peserta ketika mengikuti sesi Training.</p>
            </div>

            <!-- TABEL PENILAIAN -->
            <div class="overflow-x-auto border border-slate-800 rounded-xl">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-800/80 text-slate-300 text-xs uppercase tracking-wider border-b border-slate-700">
                            <th class="p-3 sm:p-4 w-16 text-center">No</th>
                            <th class="p-3 sm:p-4">Kategori & Detail Penilaian</th>
                            <th class="p-3 sm:p-4 w-28 text-center">Ceklis (Sudah)</th>
                            <th class="p-3 sm:p-4 w-1/3">Komentar / Catatan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800 text-sm" id="checklistTableBody">
                        
                        <!-- A. DigiX -->
                        <tr class="bg-slate-900/50"><td colspan="4" class="p-3 font-bold text-indigo-400">A. DigiX</td></tr>
                        <tr data-kategori="DigiX" data-detail="Materi Deliver: Staff DW sudah mengetahui materi DigiX">
                            <td class="p-3 text-center text-slate-400">1</td>
                            <td class="p-3 text-slate-200">Staff DW sudah mengetahui materi DigiX</td>
                            <td class="p-3 text-center">
                                <input type="checkbox" value="Sudah" class="ceklis-input w-5 h-5 accent-indigo-500 rounded bg-slate-950 border-slate-700 cursor-pointer">
                            </td>
                            <td class="p-3">
                                <input type="text" placeholder="Catatan..." class="komentar-input w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-slate-200 text-xs focus:ring-1 focus:ring-indigo-500 focus:outline-none">
                            </td>
                        </tr>
                        <tr data-kategori="DigiX" data-detail="Roleplay: Staff DW sudah melakukan Roleplay DigiX">
                            <td class="p-3 text-center text-slate-400">2</td>
                            <td class="p-3 text-slate-200">Staff DW sudah melakukan Roleplay DigiX</td>
                            <td class="p-3 text-center">
                                <input type="checkbox" value="Sudah" class="ceklis-input w-5 h-5 accent-indigo-500 rounded bg-slate-950 border-slate-700 cursor-pointer">
                            </td>
                            <td class="p-3">
                                <input type="text" placeholder="Catatan..." class="komentar-input w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-slate-200 text-xs focus:ring-1 focus:ring-indigo-500 focus:outline-none">
                            </td>
                        </tr>

                        <!-- B. How to Activation -->
                        <tr class="bg-slate-900/50"><td colspan="4" class="p-3 font-bold text-indigo-400">B. How to Activation</td></tr>
                        <tr data-kategori="How to Activation" data-detail="Materi Deliver: Staff DW sudah mengetahui langkah - langkah melakukan aktifasi device">
                            <td class="p-3 text-center text-slate-400">3</td>
                            <td class="p-3 text-slate-200">Staff DW sudah mengetahui langkah - langkah melakukan aktifasi device</td>
                            <td class="p-3 text-center">
                                <input type="checkbox" value="Sudah" class="ceklis-input w-5 h-5 accent-indigo-500 rounded bg-slate-950 border-slate-700 cursor-pointer">
                            </td>
                            <td class="p-3">
                                <input type="text" placeholder="Catatan..." class="komentar-input w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-slate-200 text-xs focus:ring-1 focus:ring-indigo-500 focus:outline-none">
                            </td>
                        </tr>

                        <!-- C. iPhone 18 (Sekilas Pandang) -->
                        <tr class="bg-slate-900/50"><td colspan="4" class="p-3 font-bold text-indigo-400">C. iPhone 18 (Sekilas Pandang)</td></tr>
                        <tr data-kategori="iPhone 18" data-detail="iPhone 18: Staff DW sudah mengetahui dan mempelajari iPhone 18-Sekilas Pandang">
                            <td class="p-3 text-center text-slate-400">4</td>
                            <td class="p-3 text-slate-200">Staff DW sudah mengetahui dan mempelajari "iPhone 18-Sekilas Pandang"</td>
                            <td class="p-3 text-center">
                                <input type="checkbox" value="Sudah" class="ceklis-input w-5 h-5 accent-indigo-500 rounded bg-slate-950 border-slate-700 cursor-pointer">
                            </td>
                            <td class="p-3">
                                <input type="text" placeholder="Catatan..." class="komentar-input w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-slate-200 text-xs focus:ring-1 focus:ring-indigo-500 focus:outline-none">
                            </td>
                        </tr>

                        <!-- D. Roleplay -->
                        <tr class="bg-slate-900/50"><td colspan="4" class="p-3 font-bold text-indigo-400">D. Roleplay</td></tr>
                        <tr data-kategori="Roleplay" data-detail="Usher: Staff DW melakukan roleplay sebagai USHER ketika NPI">
                            <td class="p-3 text-center text-slate-400">5</td>
                            <td class="p-3 text-slate-200">Staff DW melakukan roleplay sebagai USHER ketika NPI</td>
                            <td class="p-3 text-center">
                                <input type="checkbox" value="Sudah" class="ceklis-input w-5 h-5 accent-indigo-500 rounded bg-slate-950 border-slate-700 cursor-pointer">
                            </td>
                            <td class="p-3">
                                <input type="text" placeholder="Catatan..." class="komentar-input w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-slate-200 text-xs focus:ring-1 focus:ring-indigo-500 focus:outline-none">
                            </td>
                        </tr>
                        <tr data-kategori="Roleplay" data-detail="Accessories: Staff DW sudah melakukan Roleplay bagaimana menawarkan Accessories ketika NPI">
                            <td class="p-3 text-center text-slate-400">6</td>
                            <td class="p-3 text-slate-200">Staff DW sudah melakukan Roleplay bagaimana menawarkan Accessories ketika NPI</td>
                            <td class="p-3 text-center">
                                <input type="checkbox" value="Sudah" class="ceklis-input w-5 h-5 accent-indigo-500 rounded bg-slate-950 border-slate-700 cursor-pointer">
                            </td>
                            <td class="p-3">
                                <input type="text" placeholder="Catatan..." class="komentar-input w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-slate-200 text-xs focus:ring-1 focus:ring-indigo-500 focus:outline-none">
                            </td>
                        </tr>
                        <tr data-kategori="Roleplay" data-detail="Activator: Staff DW sudah melakukan Roleplay bagaimana caranya aktifasi unit ketika NPI">
                            <td class="p-3 text-center text-slate-400">7</td>
                            <td class="p-3 text-slate-200">Staff DW sudah melakukan Roleplay bagaimana caranya aktifasi unit ketika NPI</td>
                            <td class="p-3 text-center">
                                <input type="checkbox" value="Sudah" class="ceklis-input w-5 h-5 accent-indigo-500 rounded bg-slate-950 border-slate-700 cursor-pointer">
                            </td>
                            <td class="p-3">
                                <input type="text" placeholder="Catatan..." class="komentar-input w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-slate-200 text-xs focus:ring-1 focus:ring-indigo-500 focus:outline-none">
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>

            <!-- Tombol Submit -->
            <div class="flex justify-end pt-4">
                <button type="submit" id="submitBtn" class="bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-8 py-3 rounded-xl transition duration-200 shadow-lg shadow-indigo-600/30 flex items-center gap-2">
                    <span>Submit Penilaian</span>
                </button>
            </div>

        </form>
    </div>

    <!-- Script Integrasi -->
    <script>
        // Ganti URL di bawah ini dengan URL Web App Apps Script Anda yang berakhiran /exec
        const scriptURL = 'https://script.google.com/macros/s/AKfycb.../exec'; 

        const form = document.getElementById('dwForm');
        const submitBtn = document.getElementById('submitBtn');

        form.addEventListener('submit', e => {
            e.preventDefault();
            
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Mengirim data...';

            const nama = document.getElementById('nama').value;
            const tanggal = document.getElementById('tanggal').value;
            const store = document.getElementById('store').value;

            // Kumpulkan data baris dari tabel ceklis
            const rows = document.querySelectorAll('#checklistTableBody tr[data-kategori]');
            let items = [];

            rows.forEach(row => {
                const kategori = row.getAttribute('data-kategori');
                const detail = row.getAttribute('data-detail');
                const checkbox = row.querySelector('.ceklis-input');
                const komentarInput = row.querySelector('.komentar-input');

                items.push({
                    kategori: kategori,
                    detail: detail,
                    ceklis: checkbox.checked ? 'Sudah' : 'Belum',
                    komentar: komentarInput.value || '-'
                });
            });

            const payload = {
                nama: nama,
                tanggal: tanggal,
                store: store,
                items: items
            };

            fetch(scriptURL, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(() => {
                alert('Form Ceklis Daily Worker berhasil disubmit dan tersimpan ke Google Sheet!');
                form.reset();
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Submit Penilaian';
            })
            .catch(error => {
                console.error('Error!', error.message);
                alert('Terjadi kesalahan saat mengirim data.');
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Submit Penilaian';
            });
        });
    </script>
</body>
</html>
